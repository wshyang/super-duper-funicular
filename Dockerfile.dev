# syntax=docker/dockerfile:1.7
# Cloud development container preserving the platform agent contract.
FROM node:22.12.0-alpine3.20
ENV HOST=0.0.0.0 \
    PORT=3000 \
    VIPER_APP_PORT=3001 \
    VIPER_AGENT_PORT=9111
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
COPY viper-agent/ /app/viper-agent/
RUN addgroup -g 1001 app && adduser -u 1001 -G app -D app && chown -R 1001:1001 /app
USER 1001:1001
EXPOSE 3000 3001 9111
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
