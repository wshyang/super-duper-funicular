# Development image for the platform's cloud dev container.
# It keeps the agent contract (viper-agent, port 3000 for the app, 3001 for the
# agent) and starts Vite with the forwarded host allowlisted.

FROM node:22.18.0-alpine3.22
WORKDIR /app

RUN apk add --no-cache bash
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund

COPY . .

ENV HOST=0.0.0.0
ENV PORT=3000
ENV VIPER_APP_PORT=3001

EXPOSE 3000
EXPOSE 3001

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
