{
  "name": "stride-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "vitest run tests/frontend/unit",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests *.ts *.json",
    "format:check": "prettier --check src tests *.ts *.json",
    "test:e2e:sandbox": "node scripts/test-e2e-sandbox.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "serve": "14.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "138.0.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.34.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "vitest": "5.0.5"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/linux-x64": "4.1.0"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
