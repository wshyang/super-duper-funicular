{
  "name": "super-duper-funicular",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Revised photographic-sprite pipeline for running animations: branch assessment of PR #1 / PR #8, adopted GREENFIELD discipline, and the pipeline design of record",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm test",
    "persona:run": "tsx scripts/run-persona-pipeline.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.4.4",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}