{
  "name": "super-duper-funicular",
  "version": "2.0.0-p2",
  "private": true,
  "type": "module",
  "description": "Keyframe-Anchored Photographic Pipeline (KAPP/P2) for photographic running-sprite generation",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "persona:bible": "tsx scripts/persona-bible.ts",
    "register-plates": "tsx scripts/register-plates.ts",
    "conform": "tsx scripts/register-plates.ts",
    "compose": "tsx scripts/compose.ts",
    "extract-parts": "tsx scripts/extract-parts.ts"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
