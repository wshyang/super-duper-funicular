{
  "name": "super-duper-funicular",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Revised photographic-sprite pipeline for running animations: branch assessment of PR #1 / PR #8, adopted GREENFIELD discipline, and the pipeline design of record",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  }
}
