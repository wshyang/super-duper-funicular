{
  "name": "funicular-runner-lab",
  "version": "0.1.0",
  "private": true,
  "description": "A deterministic runner sprite and gait laboratory built around the supplied reference sheet.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pipeline": "tsx tools/run-pipeline.ts",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "lint": "eslint src tests tools vite.config.ts vitest.config.ts eslint.config.js",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"tools/**/*.ts\" \"*.{json,html,ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"tools/**/*.ts\" \"*.{json,html,ts,js}\""
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.18.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "10.13.0",
    "globals": "16.4.0",
    "jpeg-js": "0.4.4",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
